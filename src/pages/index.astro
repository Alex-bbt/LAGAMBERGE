---
/* ==========================================================================
   LA GAMBERGE — MEDIA KIT (page principale)
   --------------------------------------------------------------------------
   Six étapes, dans l'ordre du raisonnement d'une marque :
   1. Présentation (#profil)                 Qui est-ce ?                 — fond clair
   2. Statistiques et audience (#statistiques) Son audience m'intéresse-t-elle ? — fond poudre
   3. Pourquoi moi ? (#pourquoi)             Pourquoi le choisir ?        — fond blanc
   4. Back to Run (#back-to-run)             A-t-il mobilisé une communauté ? — fond Bone
   5. Mes deux grands objectifs (#objectifs) Quels projets accompagner ?  — fond clair
   6. Comment collaborer ? (#collaborer, #contact) Comment collaborer ?   — fond bleu roi

   Sur grand écran, chaque section occupe au moins un écran (.section--ample) ;
   sur mobile, hauteur naturelle. Détails : /statistiques, /communaute,
   /projets, /histoire. Données : src/data/mediakit.js.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Contact from '../components/Contact.astro';
import AudienceGraphiques from '../components/AudienceGraphiques.astro';
import { Image } from 'astro:assets';
import { identite, performances, courses, stats, backToRun, offres, references, photos, nombre } from '../data/mediakit.js';
import logoBtr from '../assets/back-to-run/btr-logo-mascotte.png';

// Logos officiels fournis par Alex (src/assets/logos/), référencés par nom de fichier dans les données.
const fichiersLogos = import.meta.glob('../assets/logos/*.{png,jpg,jpeg,svg,webp}', { eager: true });
const logo = (f) => (f ? fichiersLogos[`../assets/logos/${f}`]?.default : null);

const ig = stats.instagram;
const tt = stats.tiktok;
const cumul = stats.cumul;
const chronos = performances.filter((p) => p.accueil);
const projets = courses.filter((c) => !c.resultat && c.principal);
const autresEcheances = courses.filter((c) => !c.resultat && !c.principal).length;
// Chiffres de l'accueil (les valeurs exactes, dont 1 293 participants et
// 99 657 km, restent sur /communaute).
const btr = (l) => backToRun.principaux.find((c) => c.legende === l);
const preuves = [
  { valeur: nombre(btr('inscrits').valeur), legende: 'inscrits' },
  { valeur: nombre(btr('finishers des 30 jours').valeur), legende: 'finishers : 30 jours de défi terminés' },
  { prefixe: 'près de', valeur: '100 000', legende: 'km enregistrés' },
];
const marques = references.filter((r) => r.publier);
---

<Base>
  <!-- ======================= 1. PRÉSENTATION ======================= -->
  <section id="profil" class="section section--ample fond-clair" aria-labelledby="titre-profil">
    <div class="conteneur compo compo--texte-photo compo--centre">
      <div class="compo__contenu presentation" data-apparition>
        <h1 class="display-xl identite__marque presentation__marque" id="titre-profil">{identite.marque}</h1>
        <p class="title">{identite.positionnement}</p>
        <p class="lead">{identite.description}</p>
        <div class="actions">
          <a href="#statistiques" class="lg-btn lg-btn--primary">Découvrir le media kit</a>
          <a href="#collaborer" class="lg-btn btn-accent">Collaborer</a>
        </div>
        <p class="caption texte-muted">{identite.personne.nom} · {identite.personne.contexte.join(' · ')}</p>
      </div>
      <div class="compo__media media-presentation">
        <Photo photo={identite.photo} format="naturel" prioritaire sizes="(max-width: 720px) 80vw, 460px" />
      </div>
    </div>
  </section>

  <!-- ================== 2. STATISTIQUES ET AUDIENCE ================== -->
  <section id="statistiques" class="section section--ample fond-poudre" aria-labelledby="titre-statistiques">
    <div class="conteneur pile-ample">
      <h2 class="display-l" id="titre-statistiques" data-apparition>Statistiques et audience</h2>

      <div class="dominants" data-apparition>
        <!-- Tuiles d'information : non cliquables (aucun lien, aucun rôle bouton) -->
        <ul class="dominants__liste" role="list">
          <li class="tuile-stat"><span class="dominant">{nombre(cumul.abonnes)}</span><span class="lead">{cumul.abonnesLegende}</span></li>
          <li class="tuile-stat"><span class="dominant">{cumul.vuesAffichage}</span><span class="lead">{cumul.vuesLegende}</span></li>
        </ul>
        <p class="caption texte-muted">{cumul.note}<br />{cumul.periodes}</p>
        <details class="details-sobre">
          <summary class="body">Détail par plateforme</summary>
          <div class="details-sobre__corps">
            <table class="tableau-plateformes body">
              <thead><tr><th scope="col">Plateforme</th><th scope="col">Abonnés</th><th scope="col">Vues 2026</th><th scope="col">Relevé</th></tr></thead>
              <tbody>
                <tr><th scope="row">Instagram</th><td>{nombre(ig.abonnes)}</td><td>{nombre(ig.vues)}</td><td>{ig.releve}</td></tr>
                <tr><th scope="row">TikTok</th><td>{nombre(tt.abonnes)}</td><td>{nombre(tt.vues)}</td><td>{tt.releve}</td></tr>
              </tbody>
            </table>
          </div>
        </details>
      </div>

      <div class="panneau-graphiques" data-apparition>
        <AudienceGraphiques />
      </div>
      <a class="lg-btn lg-btn--glass" href="/statistiques">Contenus et audience</a>
    </div>
  </section>

  <!-- ======================= 3. POURQUOI MOI ? ======================= -->
  <section id="pourquoi" class="section section--ample fond-blanc" aria-labelledby="titre-pourquoi">
    <div class="conteneur pile-ample">
      <h2 class="display-l" id="titre-pourquoi" data-apparition>Pourquoi moi ?</h2>

      <!-- A. Crédibilité sportive -->
      <article class="argument" aria-labelledby="titre-credibilite" data-apparition>
        <div class="argument__media">
          <Photo photo={photos.performance} format="naturel" sizes="(max-width: 720px) 80vw, 360px" />
        </div>
        <div class="argument__texte">
          <p class="repere caption">01 · Crédibilité sportive</p>
          <h3 class="title" id="titre-credibilite">Un avis ancré dans la pratique</h3>
          <p class="lead intro">Je m’investis dans des objectifs préparés sur plusieurs mois, que je partage de la préparation jusqu’à la course.</p>
          <p class="lead"><a class="lien-defi" href="/defi-2026">Au moins 5 km chaque jour en 2026.</a></p>
          <!-- Tuiles cliquables : chaque chrono mène à sa fiche sur /performances -->
          <ul class="chronos-tuiles" role="list" aria-label="Références sur route">
            {chronos.map((p) => (
              <li>
                <a class="tuile-chrono" href={`/performances#${p.id}`}>
                  <span class="chiffre title">{p.resultat}</span>
                  <span class="body">{p.court}</span>
                  <span class="tuile-chrono__destination caption">Mes performances</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <!-- B. Une aventure suivie -->
      <article class="argument argument--inverse" aria-labelledby="titre-aventure" data-apparition>
        <div class="argument__media">
          <Photo photo={photos.divertissement} format="portrait" sizes="(max-width: 720px) 80vw, 360px" />
        </div>
        <div class="argument__texte">
          <p class="repere caption">02 · Divertissement</p>
          <h3 class="title" id="titre-aventure">La performance n’empêche pas le divertissement.</h3>
          <p class="lead intro">Je prends mes objectifs au sérieux, sans renoncer à l’humour. Quand le chrono passe au second plan, je laisse davantage de place aux expériences, à l’autodérision et au divertissement.</p>
          <div class="engagement">
            <ul class="engagement__taux" role="list">
              <li><span class="label texte-muted">Instagram</span><span class="chiffre title">{ig.engagement}</span><span class="body">{ig.engagementLegende}</span></li>
              <li><span class="label texte-muted">TikTok</span><span class="chiffre title">{tt.engagementCourt}</span><span class="body">{tt.engagementLegende}</span></li>
            </ul>
            <details class="details-sobre">
              <summary class="caption">Calcul des deux taux</summary>
              <div class="details-sobre__corps caption texte-muted">
                <p>Instagram : {ig.engagementDetail}</p>
                <p>TikTok : {tt.engagementDetail}</p>
                <p>Les dénominateurs diffèrent (couverture, vues) : les deux taux ne se comparent pas directement.</p>
              </div>
            </details>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- ======================= 4. BACK TO RUN ======================= -->
  <section id="back-to-run" class="section section--ample fond-accent" aria-labelledby="titre-btr">
    <div class="conteneur pile-ample">
    <!-- Entrée de la section (transition depuis « Pourquoi moi ? ») -->
    <p class="entree-btr title" data-apparition>Et quand la communauté passe à l’action ?</p>
    <!-- Logo + mascotte rattachés au titre, sur toute la largeur -->
    <div class="btr-titre" data-apparition>
      <Image src={logoBtr} alt="Back to Run" class="logo-btr" width={440} format="webp" />
      <h2 class="display-l" id="titre-btr">Back to Run : faire participer la communauté</h2>
    </div>
    <div class="compo compo--texte-photo compo--centre compo--egal">
      <div class="compo__contenu" data-apparition>
        <p class="lead intro">J’ai créé un défi collectif : courir au moins 5 km par jour pendant 30 jours. Après une première édition réunissant plus de 2 000 inscrits, Back to Run reviendra en septembre 2027.</p>
        <ul class="preuves-btr" role="list" aria-label="Back to Run, première édition (septembre 2026)">
          {preuves.map((c) => (
            <li><span class="chiffre title">{c.prefixe && <span class="chiffre__prefixe">{c.prefixe} </span>}{c.valeur}</span><span class="body">{c.legende}</span></li>
          ))}
        </ul>
        <p class="caption texte-muted">Première édition : septembre 2026. Finisher : statut officiel du défi, selon ses règles (Tribunal compris).</p>
        <a class="lg-btn lg-btn--primary" href="/communaute">Découvrir Back to Run</a>
      </div>
      <div class="compo__media" data-apparition>
        <Photo photo={backToRun.photo} format="quatre-tiers" sizes="(max-width: 1080px) 100vw, 580px" />
      </div>
    </div>
    </div>
  </section>

  <!-- ======================= 5. PROCHAINS OBJECTIFS ======================= -->
  <section id="objectifs" class="section section--ample fond-clair" aria-labelledby="titre-objectifs">
    <div class="conteneur compo compo--photo-texte compo--centre compo--egal">
      <div class="compo__media media-objectifs" data-apparition>
        <!-- Photo personnelle (course sur route) : illustration, pas une image de trail ni de la SaintéLyon -->
        <Photo photo={photos.personnelle} format="portrait" sizes="(max-width: 720px) 100vw, 440px" />
      </div>
      <div class="compo__contenu" data-apparition>
        <h2 class="display-l" id="titre-objectifs">Mes deux grands objectifs</h2>
        <ul class="rendez-vous-grands" role="list">
          {projets.map((c) => (
            <li class:list={['rendez-vous-grand', { 'rendez-vous-grand--logo': logo(c.logo) }]}>
              {logo(c.logo) && (
                <Image src={logo(c.logo)} alt={`Logo ${c.nom}`} class="rendez-vous-grand__logo" height={112} format="webp" />
              )}
              <span class="label texte-muted">{c.dateCourte ?? c.date}</span>
              <h3 class="title">{c.nom}</h3>
              <p class="lead">{c.accrocheAccueil ?? c.accroche}</p>
            </li>
          ))}
        </ul>
        <a class="lg-btn lg-btn--glass" href="/projets">{`Tout le calendrier · ${autresEcheances} autres échéances`}</a>
      </div>
    </div>
  </section>

  <!-- ======================= 6. COMMENT COLLABORER ? ======================= -->
  <section id="collaborer" class="section section--ample fond-roi" aria-labelledby="titre-collaborer">
    <div class="conteneur pile-ample">
      <h2 class="display-l" id="titre-collaborer" data-apparition>Comment collaborer ?</h2>
      <ul class="offres-grandes" role="list" data-apparition>
        {offres.map((o, i) => (
          <li class="offre-grande">
            <span class="offre-grande__numero label">Offre {i + 1}</span>
            <h3 class="title">{o.titre}</h3>
            <p class="lead">{o.texte}</p>
            <p class="body offre-grande__precision">{o.precision}</p>
          </li>
        ))}
      </ul>
      {marques.length > 0 && (
        <div class="references" data-apparition>
          <h3 class="label references__titre">Ils m’ont fait confiance</h3>
          <ul class="references__liste" role="list">
            {marques.map((m) => (
              <li class:list={['references__marque', { 'references__marque--logo': logo(m.logo) }]}>
                {logo(m.logo) ? <Image src={logo(m.logo)} alt={m.nom} class="references__logo" height={96} format="webp" /> : m.nom}
              </li>
            ))}
          </ul>
        </div>
      )}
      <Contact />
    </div>
  </section>
</Base>
