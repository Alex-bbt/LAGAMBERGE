---
/* ==========================================================================
   LA GAMBERGE — PAGE D'ACCUEIL EN CHAPITRES
   --------------------------------------------------------------------------
   Prologue → Chapitre 1 (coureur) → 2 (créateur) → 3 (Back to Run)
   → 4 (SaintéLyon) → Épilogue (marques + contact).

   Les textes se changent dans src/data/contenu.js, les chiffres dans
   src/data/chiffres.js : pas besoin de toucher à ce fichier.

   Règle du design system : chaque chapitre est un lg-ambient, en alternant
   avec lg-ambient--flip, et le contenu est posé sur du verre (lg-glass).
   ========================================================================== */
import Base from '../layouts/Base.astro';
import ARemplir from '../components/ARemplir.astro';
import Photo from '../components/Photo.astro';
import CarteChiffre from '../components/CarteChiffre.astro';
import Streak from '../components/Streak.astro';
import { contenu } from '../data/contenu.js';
import { chiffres } from '../data/chiffres.js';

const { prologue, coureur, createur, communaute, saintelyon, epilogue, reseaux } = contenu;
const date = chiffres.dateChiffres;
const annee = chiffres.annee;
const contact = epilogue.email ? `mailto:${epilogue.email}` : '#contact';
---

<Base>
  <!-- ============================ PROLOGUE ============================ -->
  <section id="prologue" class="lg-ambient chapitre">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Prologue</span>
        <h1 class="display-xl">{prologue.titre}</h1>
        <p class="lead">{prologue.chapeau}</p>
        <p class="body">{prologue.phrase ?? <ARemplir texte="TEXTE À ÉCRIRE PAR ALEX : qui je suis, en une phrase" />}</p>
        <div class="actions">
          <a href={contact} class="lg-btn lg-btn--primary">Travailler ensemble</a>
          <a href="#chapitre-1" class="lg-btn lg-btn--glass">Lire l'histoire</a>
        </div>
      </div>
      <Photo photo={prologue.photo} format="portrait" />
    </div>
  </section>

  <!-- ===================== CHAPITRE 1 : LE COUREUR ===================== -->
  <section id="chapitre-1" class="lg-ambient lg-ambient--flip chapitre">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Chapitre 1</span>
        <h2 class="display-l">{coureur.titre}</h2>
        <p class="lead">{coureur.chapeau ?? <ARemplir />}</p>
      </div>
      <div class="chapitre__preuve">
        <Photo photo={coureur.photo} />
        <div class="grille">
          <!-- Carte forte du chapitre : le streak Strava en direct -->
          <div class="pleine-largeur"><Streak /></div>
          {coureur.chronos.map((c) => (
            <CarteChiffre
              valeur={c.temps}
              legende={c.epreuve ?? 'Épreuve à préciser'}
              source={c.source}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CHAPITRE 2 : LE CRÉATEUR ===================== -->
  <section id="chapitre-2" class="lg-ambient chapitre">
    <div class="chapitre__inner chapitre__inner--seul">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Chapitre 2</span>
        <h2 class="display-l">{createur.titre}</h2>
        <p class="lead">{createur.chapeau ?? <ARemplir />}</p>
      </div>
      <div class="grille grille--4">
        <CarteChiffre valeur={chiffres.instagram.abonnes} legende="abonnés Instagram" source="Meta" date={date} dater />
        <CarteChiffre valeur={chiffres.instagram.vuesAnnee} legende={`vues Instagram en ${annee}`} source="Meta" date={date} dater royal />
        <CarteChiffre valeur={chiffres.tiktok.abonnes} legende="abonnés TikTok" source="TikTok" date={date} dater />
        <CarteChiffre valeur={chiffres.tiktok.vuesAnnee} legende={`vues TikTok en ${annee}`} source="TikTok" date={date} dater />
      </div>
    </div>
  </section>

  <!-- ============== CHAPITRE 3 : LA COMMUNAUTÉ (BACK TO RUN) ============== -->
  <section id="chapitre-3" class="lg-ambient lg-ambient--flip chapitre">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Chapitre 3</span>
        <h2 class="display-l">{communaute.titre}</h2>
        <p class="lead">{communaute.chapeau}</p>
        {communaute.lien
          ? <a href={communaute.lien} class="lg-btn lg-btn--glass" target="_blank" rel="noopener noreferrer">Découvrir Back to Run</a>
          : <ARemplir texte="LIEN BACK TO RUN À FOURNIR" />}
      </div>
      <div class="chapitre__preuve">
        <Photo photo={communaute.photo} />
        <div class="grille grille--3">
          <CarteChiffre valeur={chiffres.backToRun.inscrits} legende="inscrits à Back to Run" source="Back to Run" date={date} dater royal />
          <CarteChiffre valeur={chiffres.backToRun.kmCommunaute} legende="km courus par la communauté" source="Back to Run" date={date} dater />
          <CarteChiffre valeur={chiffres.backToRun.actifsParJour} legende="actifs chaque jour" source="Back to Run" date={date} dater />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CHAPITRE 4 : CE QUI ARRIVE (SAINTÉLYON) ================= -->
  <section id="chapitre-4" class="lg-ambient chapitre">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Chapitre 4</span>
        <h2 class="display-l">{saintelyon.titre}</h2>
        <p class="lead">{saintelyon.chapeau ?? <ARemplir />}</p>
      </div>
      <div class="chapitre__preuve">
        <Photo photo={saintelyon.photo} />
        <div class="grille">
          <div class="lg-glass lg-glass--royal carte">
            <span class="label">La course</span>
            <span class="title">{saintelyon.date ?? <ARemplir texte="DATE À CONFIRMER" />}</span>
          </div>
          <div class="lg-glass carte">
            <span class="label">La préparation</span>
            <p class="body">{saintelyon.materiel ?? <ARemplir texte="TEXTE À ÉCRIRE PAR ALEX : le matériel de course" />}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ ÉPILOGUE ============================ -->
  <section id="contact" class="lg-ambient lg-ambient--flip chapitre">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Épilogue</span>
        <h2 class="display-l">{epilogue.titre}</h2>
        <p class="lead">{epilogue.chapeau ?? <ARemplir />}</p>
        <div class="lg-glass carte">
          <h3 class="label">Ils m'ont fait confiance</h3>
          <div class="marques">
            {epilogue.marques.length > 0
              ? epilogue.marques.map((m) => <span class="lg-chip">{m}</span>)
              : <ARemplir texte="NOMS DES MARQUES À CONFIRMER" />}
          </div>
        </div>
      </div>

      <div class="chapitre__preuve">
        <div class="lg-glass lg-glass--royal carte">
          <h3 class="title">Me contacter</h3>
          <p class="body">
            {epilogue.email
              ? <a href={contact}>{epilogue.email}</a>
              : <ARemplir texte="EMAIL DE CONTACT À FOURNIR" />}
          </p>
          <p class="caption texte-muted">Ou en message privé sur Instagram, {reseaux[0].pseudo}.</p>
        </div>
        <div class="grille">
          {reseaux.map((r) => (
            <a class="lg-glass reseau" href={r.lien} target="_blank" rel="noopener noreferrer">
              <span>
                <span class="title">{r.nom}</span><br />
                <span class="caption texte-muted">{r.pseudo}</span>
              </span>
              <!-- Icône « lien externe » : trait de 2 px en bleu roi (charte) -->
              <svg class="reseau__fleche" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <footer class="lg-glass pied">
      <span class="wordmark">LA GAMBERGE</span>
      <span class="caption texte-muted">
        Chiffres au {date ?? <ARemplir texte="DATE À CONFIRMER" />} · © {new Date().getFullYear()} Alex Bourbigot
      </span>
    </footer>
  </section>
</Base>
