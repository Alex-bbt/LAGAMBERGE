---
/* ==========================================================================
   LA GAMBERGE — MEDIA KIT (page principale = synthèse)
   --------------------------------------------------------------------------
   #profil · #coureur · #createur · #audience · #back-to-run · #objectifs ·
   #collaborer (contact : #contact)

   L'accueil ne montre que l'essentiel ; les détails vivent dans /histoire,
   /statistiques, /communaute et /projets. Tout le contenu chiffré vient de
   src/data/mediakit.js.
   Mise en page : chiffres posés sur le fond avec séparateurs, cartes réservées
   aux regroupements utiles, bleu roi réservé aux éléments prioritaires.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import DefiQuotidien from '../components/DefiQuotidien.astro';
import Progression from '../components/Progression.astro';
import CarteVideo from '../components/CarteVideo.astro';
import AudienceOnglets from '../components/AudienceOnglets.astro';
import Contact from '../components/Contact.astro';
import {
  identite, performances, courses, stats, videos, backToRun,
  offres, references, defi, photos, nombre,
} from '../data/mediakit.js';

const ig = stats.instagram;
const tt = stats.tiktok;
const marathon = performances.find((p) => p.forte);
const route = performances.filter((p) => p.type === 'route');
const trail = performances.filter((p) => p.type === 'trail');
// Courses terminées : elles rejoignent les références automatiquement.
const resultatsCourses = courses.filter((c) => c.resultat);
const aVenir = courses.filter((c) => !c.resultat && c.accueil);
const principaux = aVenir.filter((c) => c.principal);
const autres = aVenir.filter((c) => !c.principal);
const videoDe = (section) => videos.find((v) => v.section === section && v.principale);
const videoCoureur = videoDe('coureur');
const videoCreateur = videoDe('createur');
const tribunal = backToRun.secondaires.find((s) => s.legende.includes('Tribunal'));
const referencesPubliees = references.filter((r) => r.publier && r.nature);
---

<Base>
  <!-- ======================= 1. LA GAMBERGE ======================= -->
  <section id="profil" class="lg-ambient chapitre" aria-labelledby="titre-profil">
    <div class="chapitre__inner hero">
      <div class="chapitre__texte hero__texte">
        <h1 class="display-xl hero__marque" id="titre-profil">{identite.marque}</h1>
        <p class="hero__mantra title">{identite.positionnement}</p>
        <p class="lead texte-court">{identite.description}</p>
        <p class="body texte-court">{identite.promesse}</p>
        <div class="actions">
          <a href="#collaborer" class="lg-btn lg-btn--primary">Parlons partenariat</a>
          <a href="#coureur" class="lg-btn lg-btn--glass">Découvrir mon univers</a>
        </div>
        <p class="caption texte-muted">{identite.personne.nom} · {identite.personne.contexte.join(' · ')}</p>
      </div>
      <Photo photo={identite.photo} format="carre" formatMobile="paysage" prioritaire
        sizes="(max-width: 720px) 100vw, 540px" class="hero__photo" />

      <!-- Preuves : chiffres sur le fond, séparés par des filets -->
      <ul class="repere-ligne hero__preuves" role="list" aria-label="En bref">
        <li><span class="repere__valeur title">{marathon.resultat}</span><span class="repere__libelle body">Marathon de Paris</span></li>
        <li><span class="repere__valeur title">{defi.minKm} km minimum</span><span class="repere__libelle body">Chaque jour en {defi.annee}</span></li>
        <li><span class="repere__valeur title">{nombre(backToRun.principaux[0].valeur)} inscrits</span><span class="repere__libelle body">Back to Run, édition 1</span></li>
      </ul>
    </div>
  </section>

  <!-- ======================= 2. LE COUREUR ======================= -->
  <section id="coureur" class="lg-ambient lg-ambient--flip chapitre chapitre--teinte" aria-labelledby="titre-coureur">
    <div class="chapitre__inner composition composition--photo-gauche">
      <div class="composition__media">
        {videoCoureur
          ? <CarteVideo video={videoCoureur} contexte="Vidéo performance" />
          : <Photo photo={photos.performance} format="naturel" formatMobile="carre" sizes="(max-width: 720px) 100vw, 460px" />}
      </div>
      <div class="composition__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Le coureur</span>
        <h2 class="display-l titre-section" id="titre-coureur">La quête de progression.</h2>
        <p class="body texte-court">
          Du premier marathon en 2 h 59 à Paris en 2 h 38, je construis mes contenus autour d’objectifs
          concrets. Aujourd’hui, je découvre le trail et prépare la suite sur route.
        </p>

        <div class="references">
          <p class="label">Sur route</p>
          <ul class="repere-ligne repere-ligne--compacte" role="list">
            {route.map((p) => (
              <li><span class="repere__valeur lead">{p.resultat}</span><span class="repere__libelle body">{p.court}</span></li>
            ))}
          </ul>
          {[...trail, ...resultatsCourses].map((p) => (
            <p class="reference-trail">
              <span class="label">En trail</span>
              <span class="repere__valeur title">{p.classement ?? p.resultat}{p.temps && <> · {p.temps}</>}</span>
              <span class="repere__libelle body">{p.libelle ?? p.nom}</span>
            </p>
          ))}
        </div>

        <Progression />
        <DefiQuotidien />
        <p class="body texte-court">Une pratique régulière pour utiliser le matériel et partager des retours d’expérience concrets.</p>
        <a class="lien-fleche" href="/histoire">Mon parcours en détail</a>
      </div>
    </div>
  </section>

  <!-- ======================= 3. LE CRÉATEUR ======================= -->
  <section id="createur" class="lg-ambient chapitre" aria-labelledby="titre-createur">
    <div class="chapitre__inner composition composition--photo-droite">
      <div class="composition__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Le créateur</span>
        <h2 class="display-l titre-section" id="titre-createur">Le chrono compte. Le plaisir aussi.</h2>
        <p class="body texte-court">
          Entraînements, courses, découvertes et imprévus : je partage la progression avec une bonne dose
          d’autodérision.
        </p>
        {videoCreateur && <CarteVideo video={videoCreateur} contexte="Exemple de vidéo à succès" />}

        <!-- Résultats : deux plateformes, deux repères de régularité -->
        <div class="resultats">
          <div class="plateforme">
            <p class="label">Instagram</p>
            <p><span class="repere__valeur title">{ig.abonnesAffichage}</span> <span class="repere__libelle body">abonnés</span></p>
            <p><span class="repere__valeur title">{ig.vuesAffichage}</span> <span class="repere__libelle body">de vues en 2026</span></p>
          </div>
          <div class="plateforme">
            <p class="label">TikTok</p>
            <p><span class="repere__valeur title">{tt.abonnesAffichage}</span> <span class="repere__libelle body">abonnés</span></p>
            <p><span class="repere__valeur title">{tt.vuesAffichage}</span> <span class="repere__libelle body">de vues en 2026</span></p>
          </div>
        </div>
        <ul class="regularite" role="list">
          <li><strong>≈ {nombre(ig.vuesMedianesPublication)}</strong> vues médianes par publication Instagram en 2026</li>
          <li><strong>≈ {nombre(ig.vuesMedianesStory)}</strong> vues médianes par story Instagram sur les 30 derniers jours</li>
        </ul>
        <p class="caption texte-muted">Vues cumulées depuis le 1er janvier 2026. Instagram au 12 octobre ; TikTok au 10 octobre.</p>
        <a class="lien-fleche" href="/statistiques">Statistiques détaillées</a>
      </div>
      <div class="composition__media">
        <Photo photo={photos.divertissement} format="portrait" formatMobile="paysage" sizes="(max-width: 720px) 100vw, 460px" />
      </div>
    </div>
  </section>

  <!-- ======================= 3 bis. L'AUDIENCE ======================= -->
  <section id="audience" class="lg-ambient lg-ambient--flip chapitre chapitre--teinte chapitre--serre" aria-labelledby="titre-audience">
    <div class="chapitre__inner chapitre__inner--seul audience-section">
      <div class="audience-section__tete">
        <span class="lg-chip"><span class="lg-chip__dot"></span>L’audience</span>
        <h2 class="display-l titre-section" id="titre-audience">Qui suit La Gamberge ?</h2>
      </div>
      <AudienceOnglets />
      <a class="lien-fleche" href="/statistiques#audience-detaillee">Pays, villes et spectateurs TikTok</a>
    </div>
  </section>

  <!-- ======================= 4. BACK TO RUN ======================= -->
  <section id="back-to-run" class="lg-ambient chapitre" aria-labelledby="titre-btr">
    <div class="chapitre__inner composition composition--photo-droite composition--large">
      <div class="composition__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Back to Run</span>
        <h2 class="display-l titre-section" id="titre-btr">De l’écran au départ.</h2>
        <p class="body texte-court">{backToRun.texteAccueil}</p>
      </div>
      <div class="composition__media">
        <Photo photo={backToRun.photo} format="paysage" formatMobile="carre" sizes="(max-width: 720px) 100vw, 640px" />
      </div>
      <div class="composition__suite">
        <p class="label">{backToRun.edition}</p>
        <ul class="repere-ligne repere-ligne--quatre" role="list">
          {backToRun.principaux.map((c) => (
            <li class:list={{ 'repere--fort': c.forte }}>
              <span class="repere__valeur title">{nombre(c.valeur)}</span>
              <span class="repere__libelle body">{c.libelleCourt ?? c.legende}</span>
            </li>
          ))}
        </ul>
        <div class="btr-fin">
          {tribunal && <p class="body"><strong>{nombre(tribunal.valeur)}</strong> votes au Tribunal.</p>}
          <p class="body"><strong>{backToRun.prochaine}</strong></p>
          <div class="actions">
            <a class="lg-btn lg-btn--glass" href={backToRun.url} target="_blank" rel="noopener noreferrer">Découvrir le défi<span class="sr-only"> (nouvel onglet)</span></a>
            <a class="lien-fleche" href="/communaute">Les résultats en détail</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 5. LES PROCHAINS OBJECTIFS ===================== -->
  <section id="objectifs" class="lg-ambient lg-ambient--flip chapitre chapitre--teinte" aria-labelledby="titre-objectifs">
    <div class="chapitre__inner composition composition--photo-gauche">
      <div class="composition__media">
        <!-- Photo personnelle (course sur route) : illustration, pas une image de trail ni de la SaintéLyon -->
        <Photo photo={photos.personnelle} format="portrait" formatMobile="paysage" sizes="(max-width: 720px) 100vw, 460px" />
      </div>
      <div class="composition__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Les projets</span>
        <h2 class="display-l titre-section" id="titre-objectifs">Les prochains objectifs.</h2>
        <ul class="projets-principaux" role="list">
          {principaux.map((c, i) => (
            <li class:list={['projet-principal', { 'lg-glass lg-glass--royal': i === 0, 'projet-principal--trait': i !== 0 }]}>
              <span class="caption">{c.date}</span>
              <h3 class="projet-principal__nom title">{c.nom}</h3>
              <p class="body">{c.accroche}</p>
              {c.projet && <p class="caption"><strong>{c.projet}</strong></p>}
            </li>
          ))}
        </ul>
        <ol class="frise" role="list" aria-label="Autres échéances">
          {autres.map((c) => (
            <li class:list={['frise__pas', { 'frise__pas--eventuel': c.statut === 'eventuel' }]}>
              <span class="frise__date body">{c.date}</span>
              <span class="frise__nom">{c.nomCourt ?? c.nom}{c.statut === 'eventuel' && <span class="texte-muted"> · éventuel</span>}</span>
            </li>
          ))}
        </ol>
        <p class="caption texte-muted">Calendrier prévisionnel.</p>
        <a class="lien-fleche" href="/projets">Tout le calendrier</a>
      </div>
    </div>
  </section>

  <!-- ======================= 6. COLLABORER ======================= -->
  <section id="collaborer" class="lg-ambient chapitre" aria-labelledby="titre-collaborer">
    <div class="chapitre__inner chapitre__inner--seul">
      <div class="collaborer__tete">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Collaborer</span>
        <h2 class="display-l titre-section" id="titre-collaborer">Écrivons la suite ensemble.</h2>
        <p class="body texte-court">
          Accompagner un objectif, créer du contenu ou imaginer une initiative sportive : construisons une
          collaboration adaptée à votre marque.
        </p>
      </div>

      <div class="collaborer">
        <ul class="offres-liste" role="list">
          {offres.map((o) => (
            <li class="offre-ligne">
              <h3 class="offre-ligne__titre lead">{o.titre}</h3>
              <p class="body">{o.courte}</p>
            </li>
          ))}
        </ul>
        <Contact />
      </div>

      <details class="details-sobre">
        <summary>Formats, droits d’utilisation et affiliation</summary>
        <div class="details-sobre__corps">
          {offres.map((o) => (
            <div>
              <h3 class="label">{o.titre}</h3>
              <p class="body">{o.resume} {o.points.join(', ')}.</p>
              {o.note && <p class="caption texte-muted">{o.note}</p>}
            </div>
          ))}
          <div>
            <h3 class="label">Affiliation</h3>
            <p class="body">Une affiliation rémunérée peut compléter la collaboration, avec des commissions et des conditions définies ensemble.</p>
          </div>
        </div>
      </details>

      {referencesPubliees.length > 0 && (
        <div class="references-marques">
          <h3 class="label">Ils m’ont fait confiance</h3>
          <ul class="marques" role="list">
            {referencesPubliees.map((r) => <li class="lg-chip">{r.nom}<span class="sr-only"> : {r.nature}</span></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>
