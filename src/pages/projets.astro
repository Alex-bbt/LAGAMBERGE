---
/* Page « Les projets » : calendrier détaillé, statuts et sujets de contenu. */
import Base from '../layouts/Base.astro';
import EnTete from '../components/EnTete.astro';
import Calendrier from '../components/Calendrier.astro';
import { courses } from '../data/mediakit.js';

const saintelyon = courses.find((c) => c.id === 'saintelyon');
const paris = courses.find((c) => c.id === 'paris-2027');
// Idées de sujets pour les contenus, communes aux objectifs à venir.
const sujets = ['Préparation et entraînement', 'Matériel testé en conditions réelles', 'Nutrition de course', 'Récit de la course, avant, pendant et après'];
---

<Base titre="Les projets" description="Les prochains objectifs de La Gamberge : SaintéLyon, Marathon de Paris 2027 et calendrier détaillé.">
  <section class="lg-ambient chapitre" aria-labelledby="titre-projets">
    <div class="chapitre__inner chapitre__inner--seul">
      <EnTete niveau="h1" id="titre-projets" repere="Les projets" titre="Deux grands objectifs, un calendrier à suivre."
        chapeau="Chaque course ouvre des sujets à raconter. Voici ce qui arrive, avec le statut de chaque participation." />
      <div class="duo">
        {[saintelyon, paris].filter((c) => c && !c.resultat).map((c, i) => (
          <article class:list={['lg-glass', 'carte', 'projet', { 'lg-glass--royal': i === 0 }]}>
            <span class="label">{c.date}</span>
            <h2 class="display-l projet__nom">{c.nom}</h2>
            <p class="lead">{c.sujet}</p>
            {c.projet && <p class="body">Objectif : raconter l’aventure sur YouTube.</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="lg-ambient lg-ambient--flip chapitre" aria-labelledby="titre-calendrier">
    <div class="chapitre__inner chapitre__inner--seul">
      <EnTete repere="Calendrier" id="titre-calendrier" titre="Toutes les échéances." />
      <Calendrier detail />
      <p class="caption texte-muted">
        Calendrier communiqué par Alex et recoupé avec les annonces publiques au 12 octobre 2026. La date
        exacte du Marathon de Paris 2027 reste à confirmer. Les noms des courses n’impliquent aucun
        partenariat avec leurs organisateurs.
      </p>
    </div>
  </section>

  <section class="lg-ambient chapitre" aria-labelledby="titre-sujets">
    <div class="chapitre__inner">
      <div class="chapitre__texte">
        <span class="lg-chip"><span class="lg-chip__dot"></span>Contenus</span>
        <h2 class="display-l" id="titre-sujets">Ce que chaque objectif permet de raconter.</h2>
        <p class="lead">Les formats et le calendrier de publication se décident avec chaque partenaire.</p>
        <a class="lg-btn lg-btn--primary" href="/#collaborer">Parlons partenariat</a>
      </div>
      <ul class="lg-glass carte puces puces--grandes" role="list">
        {sujets.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>
</Base>
