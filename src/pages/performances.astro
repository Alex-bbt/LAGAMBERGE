---
/* ==========================================================================
   Page « Mes performances » : mur de performances.
   - Chaque tuile montre le résultat et le nom de la course.
   - Date et détails : au clic, au toucher, au clavier (Entrée/Espace), et
     au survol sur ordinateur. Basé sur <details> : tout reste accessible
     sans JavaScript et sans survol.
   - Temps réel = référence ; temps officiel affiché à part s'il existe.
   - Aucune médaille ni podium : classements tels qu'ils figurent sur les
     justificatifs. Les objectifs à venir restent dans un bloc séparé.
   Données : `performances` dans src/data/mediakit.js.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import EnTete from '../components/EnTete.astro';
import { performances, courses } from '../data/mediakit.js';

const objectifs = courses.filter((c) => !c.resultat && c.principal);
const groupes = [
  { titre: 'Sur route', items: performances.filter((p) => p.type === 'route') },
  { titre: 'En trail', items: performances.filter((p) => p.type === 'trail') },
];
const libelleTemps = (p) => (p.tempsReel ? 'Temps réel' : p.tempsCourse ? 'Temps' : null);
---

<Base titre="Mes performances" description="Les références de La Gamberge sur route et en trail : temps réels, classements et dates.">
  <section class="lg-ambient chapitre" aria-labelledby="titre-performances">
    <div class="chapitre__inner chapitre__inner--seul">
      <EnTete niveau="h1" id="titre-performances" repere="Performances réalisées" titre="Mes performances"
        chapeau="Mes références sur route et en trail." />

      {groupes.map((g) => (
        <div class="mur">
          <h2 class="label mur__titre">{g.titre}</h2>
          <ul class="mur__grille" role="list">
            {g.items.map((p) => (
              <li class="mur__case" id={p.id}>
                <details class="perf-tuile" data-perf>
                  <summary class="perf-tuile__resume">
                    <span class="chiffre title perf-tuile__resultat">{p.resultat}</span>
                    <span class="lead perf-tuile__course">{p.course}</span>
                    <span class="caption perf-tuile__ouvrir">Date et détails</span>
                  </summary>
                  <dl class="perf-tuile__details">
                    <div><dt>Date</dt><dd>{p.date}{p.dateCommuniquee && <span class="texte-muted perf-tuile__mention">communiquée</span>}</dd></div>
                    {p.distance && <div><dt>Distance</dt><dd>{p.distance}</dd></div>}
                    {libelleTemps(p) && <div><dt>{libelleTemps(p)}</dt><dd>{p.tempsReel ?? p.tempsCourse}</dd></div>}
                    {p.tempsOfficiel && <div><dt>Temps officiel</dt><dd>{p.tempsOfficiel}</dd></div>}
                    {p.classements.map((c) => <div><dt>{c.libelle}</dt><dd>{c.valeur}</dd></div>)}
                    {p.recompense && <div><dt>Récompense</dt><dd>{p.recompense}</dd></div>}
                  </dl>
                  {p.details.length > 0 && (
                    <ul class="perf-tuile__notes caption texte-muted" role="list">
                      {p.details.map((d) => <li>{d}</li>)}
                    </ul>
                  )}
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="caption texte-muted">Temps réel : du passage sur la ligne de départ à l’arrivée. Temps officiel : depuis le coup de pistolet, quand il est indiqué.</p>
    </div>
  </section>

  <!-- Objectifs : séparés des performances réalisées -->
  <section class="lg-ambient lg-ambient--flip chapitre" aria-labelledby="titre-a-venir">
    <div class="chapitre__inner chapitre__inner--seul">
      <EnTete repere="À venir" id="titre-a-venir" titre="Objectifs, pas encore des résultats." />
      <ul class="objectifs-perf" role="list">
        {objectifs.map((c) => (
          <li class="objectif-perf"><span class="label texte-muted">{c.dateCourte ?? c.date} · objectif</span><span class="lead">{c.nom} — {c.accrocheAccueil ?? c.accroche}</span></li>
        ))}
      </ul>
      <a class="lg-btn lg-btn--glass" href="/projets">Tout le calendrier</a>
    </div>
  </section>
</Base>

<script>
  // Date et détails : ouverture au clic/toucher et au clavier (natif <details>),
  // au focus, au survol sur ordinateur, et à l'arrivée par une ancre (#marathon…).
  // Un clic garde ouverte une tuile ouverte par le focus ou le survol.
  const tuiles = [...document.querySelectorAll('[data-perf]')];
  const survol = matchMedia('(hover: hover) and (pointer: fine)');
  tuiles.forEach((t) => {
    let ouvertPar = null; // 'clic' | 'focus' | 'survol' | null
    const ouvrir = (par) => { if (!t.open) { t.open = true; ouvertPar = par; } };
    t.querySelector('summary').addEventListener('click', (e) => {
      if (t.open && (ouvertPar === 'focus' || ouvertPar === 'survol')) { e.preventDefault(); ouvertPar = 'clic'; return; }
      ouvertPar = t.open ? null : 'clic';
    });
    t.addEventListener('focusin', () => ouvrir('focus'));
    t.addEventListener('focusout', (e) => { if (ouvertPar === 'focus' && !t.contains(e.relatedTarget)) { t.open = false; ouvertPar = null; } });
    t.addEventListener('mouseenter', () => { if (survol.matches) ouvrir('survol'); });
    t.addEventListener('mouseleave', () => { if (survol.matches && ouvertPar === 'survol') { t.open = false; ouvertPar = null; } });
  });
  const ouvrirCible = () => {
    const cible = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const d = cible?.querySelector('[data-perf]');
    if (d) d.open = true;
  };
  ouvrirCible();
  addEventListener('hashchange', ouvrirCible);
</script>
