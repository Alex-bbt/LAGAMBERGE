---
/* ==========================================================================
   Page « Statistiques détaillées » : toutes les valeurs exactes, périodes et
   définitions retirées de l'accueil pour garder celui-ci lisible.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import EnTete from '../components/EnTete.astro';
import Barres from '../components/Barres.astro';
import Colonnes from '../components/Colonnes.astro';
import { stats, audience, videos, nombre } from '../data/mediakit.js';

const ig = stats.instagram;
const tt = stats.tiktok;
const avecAutres = (pays) => [
  ...pays,
  { libelle: 'Autres pays', valeur: Math.round((100 - pays.reduce((s, p) => s + p.valeur, 0)) * 10) / 10 },
];
const exemples = videos.filter((v) => v.vues).sort((a, b) => b.vues - a.vues);
---

<Base titre="Statistiques détaillées" description="Statistiques détaillées des comptes Instagram et TikTok de La Gamberge, avec périodes et définitions.">
  <section class="lg-ambient chapitre" aria-labelledby="titre-stats">
    <div class="chapitre__inner chapitre__inner--seul">
      <EnTete niveau="h1" id="titre-stats" repere="Statistiques" titre="Les chiffres en détail."
        chapeau="Valeurs exactes, périodes de relevé et définitions. Les totaux cumulés de l’accueil additionnent les deux plateformes : ce n’est pas une audience dédupliquée, et les vues ne correspondent pas à des personnes uniques." />

      <div class="duo">
        <div class="tableau-stats">
          <h2 class="title">Instagram</h2>
          <p class="caption texte-muted">{ig.periode} · abonnés au {ig.releve}</p>
          <dl>
            <div><dt>Abonnés</dt><dd>{nombre(ig.abonnes)}</dd></div>
            <div><dt>Vues</dt><dd>{nombre(ig.vues)}</dd></div>
            <div><dt>Vues médianes par publication retenue</dt><dd>≈ {nombre(ig.vuesMedianesPublication)}</dd></div>
            <div><dt>Vues médianes par story (30 derniers jours)</dt><dd>≈ {nombre(ig.vuesMedianesStory)}</dd></div>
            <div><dt>Publications à plus de 10 000 vues</dt><dd>{ig.publicationsPlus10k}</dd></div>
            <div><dt>Publications à plus de 100 000 vues</dt><dd>{ig.publicationsPlus100k}</dd></div>
            <div><dt>Interactions</dt><dd>{nombre(ig.interactions)}</dd></div>
            <div><dt>Engagement</dt><dd>{ig.engagement}<span class="caption texte-muted">{ig.engagementDefinition}</span></dd></div>
          </dl>
        </div>
        <div class="tableau-stats">
          <h2 class="title">TikTok</h2>
          <p class="caption texte-muted">{tt.periode} · abonnés au {tt.releve}</p>
          <dl>
            <div><dt>Abonnés</dt><dd>{nombre(tt.abonnes)}</dd></div>
            <div><dt>Vues</dt><dd>{nombre(tt.vues)}</dd></div>
            <div><dt>Vidéos à plus de 100 000 vues</dt><dd>{tt.videosPlus100k}</dd></div>
            <div><dt>Likes</dt><dd>{nombre(tt.likes)}</dd></div>
            <div><dt>Partages</dt><dd>{nombre(tt.partages)}</dd></div>
            <div><dt>Commentaires</dt><dd>{nombre(tt.commentaires)}</dd></div>
            <div><dt>Engagement</dt><dd>{tt.engagement}<span class="caption texte-muted">{tt.engagementDefinition}</span></dd></div>
          </dl>
        </div>
      </div>
      <p class="caption texte-muted">
        Les deux taux d’engagement sont calculés différemment (couverture pour Instagram, vues pour TikTok) et ne
        se comparent pas directement. Les statistiques des publications Instagram excluent les Reels d’essai.
      </p>
    </div>
  </section>

  <section class="lg-ambient lg-ambient--flip chapitre chapitre--teinte" aria-labelledby="titre-exemples">
    <div class="chapitre__inner chapitre__inner--seul">
      <h2 class="display-l titre-section" id="titre-exemples">Exemples de vidéos à succès.</h2>
      <ul class="liste-secondaire" role="list">
        {exemples.map((v) => (
          <li>
            <span class="liste-secondaire__valeur">{v.vuesAffichage ?? nombre(v.vues)}</span>
            <span class="body">{v.titre} · {v.plateforme}, publiée le {v.publication} <span class="caption texte-muted">({nombre(v.vues)} vues au {v.releve})</span></span>
          </li>
        ))}
      </ul>
      <p class="caption texte-muted">Des exemples parmi les contenus de 2026, pas des résultats habituels.</p>
    </div>
  </section>

  <section class="lg-ambient chapitre" aria-labelledby="audience-detaillee">
    <div class="chapitre__inner chapitre__inner--seul">
      <h2 class="display-l titre-section" id="audience-detaillee">L’audience en détail.</h2>
      <div class="audience__grille">
        <div class="carte-plate"><Colonnes titre="Âge" population={audience.instagram.population} releve={audience.instagram.releve} donnees={audience.instagram.ages} note={audience.instagram.repereAge} /></div>
        <div class="carte-plate">
          <Barres titre="Genre" population={audience.instagram.population} releve={audience.instagram.releve} donnees={audience.instagram.genre} />
          <Barres titre="Genre" population={audience.tiktok.population} releve={audience.tiktok.releve} donnees={audience.tiktok.genre} />
        </div>
        <div class="carte-plate"><Barres titre="Pays" population={audience.instagram.population} releve={audience.instagram.releve} donnees={avecAutres(audience.instagram.pays)}
          note={`${audience.instagram.villeRepere.libelle} : ${audience.instagram.villeRepere.valeur.toLocaleString('fr-FR')} % des abonnés Instagram (répartition par ville).`} /></div>
        <div class="carte-plate"><Barres titre="Pays" population={audience.tiktok.population} releve={audience.tiktok.releve} donnees={avecAutres(audience.tiktok.pays)} /></div>
      </div>

      <h3 class="title">Spectateurs TikTok sur 365 jours</h3>
      <p class="body texte-court">Population différente des abonnés : les personnes qui ont vu des vidéos, abonnées ou non.</p>
      <div class="audience__grille audience__grille--trois">
        <div class="carte-plate"><Barres titre="Âge (deux tranches principales)" population={audience.tiktokSpectateurs.population} releve={audience.tiktokSpectateurs.releve} donnees={audience.tiktokSpectateurs.ages} /></div>
        <div class="carte-plate"><Barres titre="Genre" population={audience.tiktokSpectateurs.population} releve={audience.tiktokSpectateurs.releve} donnees={audience.tiktokSpectateurs.genre} note="Le complément à 100 % n’est pas détaillé par la plateforme." /></div>
        <div class="carte-plate"><Barres titre="Pays" population={audience.tiktokSpectateurs.population} releve={audience.tiktokSpectateurs.releve} donnees={audience.tiktokSpectateurs.pays} /></div>
      </div>
      <a class="lien-fleche" href="/#audience">Retour à l’accueil</a>
    </div>
  </section>
</Base>
