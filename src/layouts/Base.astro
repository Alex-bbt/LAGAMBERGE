---
/* Squelette HTML commun : métadonnées, polices, navigation flottante. */
import '../styles/site.css';
import { contenu } from '../data/contenu.js';

const description = contenu.meta.description ?? 'Alex Bourbigot, coureur, créateur de contenu et organisateur de Back to Run.';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{contenu.meta.titre}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={contenu.meta.titre} />
    <meta property="og:description" content={description} />
    <!-- Pas encore de logo dessiné : icône vide pour éviter une erreur 404. -->
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a class="evitement lg-btn lg-btn--primary" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <nav class="lg-glass lg-nav" aria-label="Navigation principale">
        <a href="#prologue" class="lg-nav__brand">LA GAMBERGE</a>
        <div class="lg-nav__links">
          {contenu.nav.map((l) => (
            <a href={l.lien} class="lg-nav__link lg-nav__link--bureau">{l.libelle}</a>
          ))}
          <a href="#contact" class="lg-btn lg-btn--primary">Collaborer</a>
        </div>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>
  </body>
</html>
