---
/* Squelette commun : métadonnées, navigation flottante, pied de page. */
import '../styles/site.css';
import { identite, contact, comptes } from '../data/mediakit.js';

// `corps` : classe ajoutée au <body> (ex. 'theme-btr' pour la page Back to Run).
const { titre, description, corps } = Astro.props;
const titrePage = titre ? `${titre} · La Gamberge` : `La Gamberge · ${identite.positionnement}`;
const desc = description ?? `${identite.description} Media kit de La Gamberge (Alex Bourbigot).`;

// Navigation : ancres de la page principale + pages complémentaires.
const liens = [
  { libelle: 'Profil', lien: '/#profil' },
  { libelle: 'Projets', lien: '/#objectifs' },
];
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const insta = comptes.find((c) => c.id === 'instagram');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titrePage}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={desc} />
    <!-- Pas encore de logo dessiné : icône vide pour éviter une erreur 404. -->
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
  </head>
  <body class={corps}>
    <a class="evitement lg-btn lg-btn--primary" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <nav class="lg-glass lg-nav" aria-label="Navigation principale">
        <a href="/" class="lg-nav__brand">LA GAMBERGE</a>
        <div class="lg-nav__links">
          {liens.map((l) => (
            <a href={l.lien} class="lg-nav__link lg-nav__link--bureau" aria-current={chemin === l.lien ? 'page' : undefined}>{l.libelle}</a>
          ))}
          <!-- Menu mobile : fonctionne sans JavaScript (élément details) -->
          <details class="menu-mobile">
            <summary class="lg-btn lg-btn--glass" aria-label="Menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
            <div class="menu-mobile__panneau lg-glass lg-glass--strong">
              {liens.map((l) => <a href={l.lien} class="lg-nav__link">{l.libelle}</a>)}
              <!-- Sur les très petits écrans, « Collaborer » passe dans le menu -->
              <a href="/#contact" class="lg-btn btn-accent menu-mobile__cta">Collaborer</a>
            </div>
          </details>
          <a href="/#contact" class="lg-btn btn-accent nav-cta">Collaborer</a>
        </div>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <!-- Pied de page : pages détaillées, réseaux et note de mise à jour (une seule) -->
    <footer class="pied-page">
      <div class="pied">
        <a href="/" class="wordmark pied__marque">LA GAMBERGE</a>
        <nav class="pied__liens" aria-label="Pages détaillées">
          <a href="/histoire">Histoire</a>
          <a href="/statistiques">Statistiques</a>
          <a href="/communaute">Communauté</a>
          <a href="/projets">Projets</a>
        </nav>
        <ul class="pied__liens" role="list" aria-label="Réseaux">
          {comptes.map((c) => (
            <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.nom}<span class="sr-only"> (nouvel onglet)</span></a></li>
          ))}
        </ul>
        <p class="caption texte-muted">
          {identite.personne.nom} · {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <a href={insta.url} target="_blank" rel="noopener noreferrer">{insta.pseudo}</a>}
          · Réseaux : relevés des 10–12 octobre 2026.
        </p>
      </div>
    </footer>

    <script>
      // Menu mobile : se ferme après un clic sur un lien, ou avec la touche Échap.
      const menu = document.querySelector('.menu-mobile');
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => menu.removeAttribute('open'))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.removeAttribute('open');
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
