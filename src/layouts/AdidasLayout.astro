---
/* ==========================================================================
   AdidasLayout — squelette des 3 pages de candidature adidas.
   Volontairement indépendant du site La Gamberge : pas de Base.astro, pas
   d'en-tête, pas de navigation, pas de pied de page du site, pas de
   site.css. Ces pages sont une candidature, pas une page du site.
   - noindex, nofollow : pages non répertoriées (aucun lien depuis le site).
   - Polices hébergées dans public/adidas/fonts (aucune requête vers Google).
   - Système visuel repris des 1-Pagers PDF (noir, blanc, bleu #1F3CFF,
     Barlow Condensed + Inter).
   ========================================================================== */
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/adidas/fonts/barlow-condensed-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/adidas/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* -- Polices (licences OFL dans public/adidas/fonts/) -------------------- */
  @font-face { font-family: 'Barlow Condensed'; src: url('/adidas/fonts/barlow-condensed-latin-700-normal.woff2') format('woff2'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Barlow Condensed'; src: url('/adidas/fonts/barlow-condensed-latin-800-normal.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Barlow Condensed'; src: url('/adidas/fonts/barlow-condensed-latin-900-normal.woff2') format('woff2'); font-weight: 900; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('/adidas/fonts/inter-latin-400-normal.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('/adidas/fonts/inter-latin-500-normal.woff2') format('woff2'); font-weight: 500; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('/adidas/fonts/inter-latin-600-normal.woff2') format('woff2'); font-weight: 600; font-display: swap; }

  /* -- Jetons (palette des 1-Pagers) --------------------------------------- */
  :root {
    --ad-ink: #0a0a0a;
    --ad-white: #ffffff;
    --ad-blue: #1f3cff;
    --ad-blue-soft: rgba(31, 60, 255, 0.18);
    --ad-text: #45474d;
    --ad-mute: #8a8c92;          /* sur fond noir uniquement */
    --ad-mute-light: #6b6d73;    /* variante lisible (AA) sur fond blanc */
    --ad-line: #e2e3e6;
    --ad-paper: #f4f4f6;
    --ad-display: 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif;
    --ad-body: 'Inter', Helvetica, Arial, sans-serif;
    --ad-gutter: clamp(1.25rem, 5vw, 2.5rem);
    --ad-max: 1100px;
    --ad-cut: clamp(28px, 6vw, 64px);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--ad-white);
    color: var(--ad-ink);
    font-family: var(--ad-body);
    font-size: 1rem;
    line-height: 1.55;
    overflow-x: hidden;
  }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3, p, ol, ul, figure { margin: 0; }
  a { color: inherit; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--ad-blue); outline-offset: 3px; }

  /* -- Briques communes ---------------------------------------------------- */
  .ad-wrap { width: 100%; max-width: var(--ad-max); margin-inline: auto; padding-inline: var(--ad-gutter); }
  .ad-lab {
    font-family: var(--ad-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ad-lab i { font-style: normal; color: var(--ad-blue); margin-right: 0.5em; }
  .ad-h2 {
    font-family: var(--ad-display);
    font-weight: 900;
    font-size: clamp(2.6rem, 9vw, 4.5rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    margin-top: 0.4rem;
  }
  .ad-h2 em { font-style: normal; color: var(--ad-blue); }
  .ad-section { padding-block: clamp(3.5rem, 9vw, 6rem); }
  .ad-section + .ad-section { border-top: 1px solid var(--ad-line); }

  /* Boutons */
  .ad-btns { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ad-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 48px;
    padding: 0.7rem 1.2rem;
    font-family: var(--ad-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid currentColor;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ad-btn--primary { background: var(--ad-blue); border-color: var(--ad-blue); color: var(--ad-white); }
  .ad-btn--primary:hover { background: var(--ad-white); border-color: var(--ad-white); color: var(--ad-ink); }
  .ad-btn--ghost { background: transparent; color: var(--ad-white); border-color: rgba(255, 255, 255, 0.55); }
  .ad-btn--ghost:hover { border-color: var(--ad-white); background: rgba(255, 255, 255, 0.08); }
  .ad-btn--dark { background: var(--ad-ink); border-color: var(--ad-ink); color: var(--ad-white); }
  .ad-btn--dark:hover { background: var(--ad-blue); border-color: var(--ad-blue); }
  @media (max-width: 480px) { .ad-btns .ad-btn { flex: 1 1 100%; } }

  /* Lien texte avec flèche */
  .ad-link {
    font-family: var(--ad-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ad-blue);
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }
  .ad-link:hover { color: var(--ad-ink); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
