---
/* ==========================================================================
   AdidasLayout — squelette des 3 pages de candidature adidas (« Shrink It »).
   Volontairement indépendant du site La Gamberge : pas de Base.astro, pas
   d'en-tête ni de pied du site. Ces pages sont une candidature.
   - noindex, nofollow : pages non répertoriées (aucun lien depuis le site).
   - Polices hébergées sur le site, aucune requête tierce au chargement :
     Archivo variable (largeur 62–125 %, graisse 100–900) dans public/adidas/fonts,
     Manrope (fichier variable déjà servi par le media kit, public/fonts/la-gamberge).
   - La classe `js` est posée sur <html> avant l'affichage : sans JS, les
     moments s'affichent directement dans leur état final.
   ========================================================================== */
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#19275F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/adidas/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* -- Polices (licences OFL) --------------------------------------------- */
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    font-display: swap;
    src: url('/adidas/fonts/archivo-latin-wdth-normal.woff2') format('woff2-variations'), url('/adidas/fonts/archivo-latin-wdth-normal.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Manrope';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('/fonts/la-gamberge/manrope-xn7gYHE41ni1AdIRggexSvfedN4.woff2') format('woff2');
  }

  /* -- Jetons (handoff « Shrink It ») ---------------------------------------- */
  :root {
    --yg-marine: #19275f;
    --yg-blanc: #f6f8fc;
    --yg-ciel: #d4e5fa;
    --yg-creme: #f1e3cc;
    --yg-orange: #d2652a;
    --yg-orange-sur-marine: #f08a4b;
    --yg-texte-clair: #4a5683;   /* texte secondaire sur fond clair */
    --yg-texte-marine: #b7c2e0;  /* texte secondaire sur marine */
    --yg-filet: #c3cbe0;
    --yg-titre: 'Archivo', 'Arial Narrow', Arial, sans-serif;
    --yg-texte: 'Manrope', Helvetica, Arial, sans-serif;
    --yg-max: 1100px;
    --yg-barre: 56px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; background: var(--yg-marine); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; color: var(--yg-marine); font-family: var(--yg-texte); line-height: 1.45; overflow-x: hidden; }
  h1, h2, p { margin: 0; }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  a:hover { color: var(--yg-orange); }
  button { font: inherit; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--yg-orange); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  /* Typo du concept : titres Archivo 900 « expanded », chiffres « extra-condensed ». */
  .yg-large { font-family: var(--yg-titre); font-weight: 900; font-stretch: 125%; text-transform: uppercase; }
  .yg-serre { font-family: var(--yg-titre); font-weight: 900; font-stretch: 75%; text-transform: uppercase; }
  .yg-etiquette { font: 700 11px/1.3 var(--yg-texte); letter-spacing: 0.14em; text-transform: uppercase; }
  .yg-accent { color: var(--yg-orange); }

  /* Un écran = une idée */
  .yg-ecran { min-height: 100svh; display: flex; flex-direction: column; padding: 28px 24px calc(var(--yg-barre) + 40px + env(safe-area-inset-bottom)); overflow: hidden; }
  .yg-col { max-width: var(--yg-max); width: 100%; margin: 0 auto; }
  .fond-marine { background: var(--yg-marine); color: #fff; }
  .fond-blanc { background: var(--yg-blanc); color: var(--yg-marine); }
  .fond-ciel { background: var(--yg-ciel); color: var(--yg-marine); }
  .fond-creme { background: var(--yg-creme); color: var(--yg-marine); }
  .fond-marine .yg-accent { color: var(--yg-orange-sur-marine); }
</style>
