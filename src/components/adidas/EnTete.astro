---
/* En-tête de section de preuve : sur-titre (repère bleu) + grand titre. */
const { surTitre, titre, id } = Astro.props;
---

<div class="entete">
  <p class="ad-lab"><i>/</i>{surTitre}</p>
  <h2 class="ad-h2" id={id}>{titre}</h2>
</div>

<style>
  .entete { margin-bottom: clamp(1.75rem, 4vw, 2.5rem); max-width: 52rem; }
  .entete .ad-h2 { font-size: clamp(2.3rem, 8vw, 3.75rem); }
</style>
