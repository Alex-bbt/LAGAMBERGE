---
/* ==========================================================================
   AdidasApplication — LA page modèle des 3 candidatures adidas.
   Prop `team` : clé de `equipes` dans src/data/adidas.js
   ('marketing' | 'brandCommunications' | 'productManagement').
   Ne changent d'une équipe à l'autre que les données (intitulé, fin de
   l'intro, chronologie, ordre des preuves, fin du paragraphe « game »,
   apports, PDF). Aucun texte en dur ici.
   ========================================================================== */
import AdidasLayout from '../../layouts/AdidasLayout.astro';
import { equipes } from '../../data/adidas.js';
import Hero from './Hero.astro';
import Splits from './Splits.astro';
import ProofBackToRun from './ProofBackToRun.astro';
import ProofLaGamberge from './ProofLaGamberge.astro';
import ProofRunner from './ProofRunner.astro';
import ProofExperience from './ProofExperience.astro';
import Jeu from './Jeu.astro';
import Apports from './Apports.astro';
import Contact from './Contact.astro';

const { team } = Astro.props;
const equipe = equipes[team];
if (!equipe) throw new Error(`Équipe adidas inconnue : « ${team} »`);

const preuves = {
  backToRun: ProofBackToRun,
  laGamberge: ProofLaGamberge,
  coureur: ProofRunner,
  experience: ProofExperience,
};
const sections = equipe.ordre.map((cle) => {
  const Composant = preuves[cle];
  if (!Composant) throw new Error(`Section de preuve inconnue : « ${cle} »`);
  return { cle, Composant };
});
---

<AdidasLayout title={equipe.title} description={equipe.description}>
  <Hero equipe={equipe} />
  <main>
    <Splits equipe={equipe} />
    <div id="preuves">
      {sections.map(({ cle, Composant }) => <Composant data-section={cle} />)}
    </div>
    <Jeu equipe={equipe} />
    <Apports equipe={equipe} />
  </main>
  <Contact equipe={equipe} />
</AdidasLayout>
