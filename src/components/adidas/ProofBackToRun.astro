---
/* Preuve « BACK TO RUN » : histoire du défi, chiffres (inscrits ≠ participants
   actifs ≠ finishers), univers (Tribunal, Coffre, mascotte, avatars), photo,
   lien vers le site. Textes : commun.sections.backToRun. */
import { commun } from '../../data/adidas.js';
import EnTete from './EnTete.astro';
import Chiffres from './Chiffres.astro';

const s = commun.sections.backToRun;
---

<section class="ad-section btr" id={s.id} aria-labelledby={`${s.id}-titre`}>
  <div class="ad-wrap">
    <EnTete surTitre={s.surTitre} titre={s.titre} id={`${s.id}-titre`} />

    <div class="btr__intro">
      <div class="btr__texte">
        {s.paragraphes.map((p) => <p>{p}</p>)}
      </div>
      <img class="btr__logo" src={s.logo.src} width={s.logo.width} height={s.logo.height} alt={s.logo.alt} loading="lazy" decoding="async" />
    </div>

    <div class="btr__chiffres"><Chiffres chiffres={s.chiffres} /></div>

    <ul class="btr__univers">
      {s.univers.map((u) => (
        <li>
          <img src={u.src} width={u.width} height={u.height} alt={u.alt} loading="lazy" decoding="async" />
          <p>{u.legende}</p>
        </li>
      ))}
    </ul>

    {s.avatars.length > 0 && (
      <div class="btr__avatars">
        <ul>
          {s.avatars.map((a) => (
            <li><img src={a.src} width="256" height="256" alt={a.alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <p>{s.avatarsLegende}</p>
      </div>
    )}

    {s.photo && (
      <figure class="btr__photo">
        <img src={s.photo.src} width={s.photo.width} height={s.photo.height} alt={s.photo.alt} loading="lazy" decoding="async" />
        <figcaption>{s.photo.legende}</figcaption>
      </figure>
    )}

    {s.lien && s.lien.url && (
      <p class="btr__lien">
        <a class="ad-link" href={s.lien.url} target="_blank" rel="noopener noreferrer">{s.lien.texte} →<span class="sr-only"> (opens in a new tab)</span></a>
      </p>
    )}
  </div>
</section>

<style>
  .btr__intro { display: grid; gap: 1.5rem; align-items: start; }
  .btr__texte { display: grid; gap: 1rem; font-size: 1.05rem; color: var(--ad-text); max-width: 40rem; }
  .btr__logo { width: 170px; justify-self: start; }
  .btr__chiffres { margin-top: 2rem; }
  .btr__univers {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .btr__univers li { background: var(--ad-paper); padding: 0.75rem 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  .btr__univers img { width: 100%; height: 120px; object-fit: contain; }
  .btr__univers p { font-size: 0.85rem; line-height: 1.4; color: var(--ad-text); }
  .btr__avatars { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .btr__avatars ul { list-style: none; padding: 0; margin: 0; display: flex; }
  .btr__avatars li + li { margin-left: -10px; }
  .btr__avatars img { width: 52px; height: 52px; border-radius: 50%; border: 3px solid var(--ad-white); }
  .btr__avatars p { font-size: 0.9rem; color: var(--ad-text); }
  .btr__photo { margin-top: 2rem; }
  .btr__photo img { width: 100%; }
  .btr__photo figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: var(--ad-mute-light); }
  .btr__lien { margin-top: 1.75rem; }

  @media (max-width: 520px) {
    .btr__univers { grid-template-columns: 1fr; }
    .btr__univers li { flex-direction: row; align-items: center; }
    .btr__univers img { width: 88px; height: 88px; flex: none; }
  }
  @media (min-width: 860px) {
    .btr__intro { grid-template-columns: minmax(0, 1fr) 240px; gap: 3rem; }
    .btr__logo { width: 240px; justify-self: end; }
    .btr__univers img { height: 170px; }
    .btr__photo { max-width: 760px; }
  }
</style>
