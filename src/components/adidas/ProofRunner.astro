---
/* Preuve « THE RUNNER » : chronos, qualifications, trail, et compteur de
   jours d'affilée EN DIRECT (/api/streak, logique Strava existante).
   Rendu serveur = valeur de secours ; le script ne la remplace que par une
   réponse Strava valide (aucune casse si l'API échoue ou est lente). */
import { commun } from '../../data/adidas.js';
import EnTete from './EnTete.astro';
import Chiffres from './Chiffres.astro';

const s = commun.sections.coureur;
---

<section class="ad-section runner" id={s.id} aria-labelledby={`${s.id}-titre`}>
  <div class="ad-wrap">
    <EnTete surTitre={s.surTitre} titre={s.titre} id={`${s.id}-titre`} />

    <div class="runner__grid">
      <div class="runner__texte">
        {s.paragraphes.map((p) => <p>{p}</p>)}
      </div>
      <div class="streak" data-ad-streak>
        <p class="streak__n" data-ad-streak-n>{s.streak.secours}</p>
        <p class="streak__l">{s.streak.legende}</p>
        <p class="streak__live" data-ad-streak-live data-libelle={s.streak.enDirect} data-maj={s.streak.misAJour} hidden></p>
      </div>
    </div>

    <div class="runner__chiffres"><Chiffres chiffres={s.chiffres} /></div>
  </div>
</section>

<script>
  // Compteur en direct : réutilise /api/streak (une seule requête, partagée
  // via window.__adStreak si plusieurs blocs). Délai max 6 s, sinon secours.
  const bloc = document.querySelector<HTMLElement>('[data-ad-streak]');
  if (bloc) {
    const n = bloc.querySelector<HTMLElement>('[data-ad-streak-n]');
    const live = bloc.querySelector<HTMLElement>('[data-ad-streak-live]');
    const ctrl = new AbortController();
    const minuteur = setTimeout(() => ctrl.abort(), 6000);
    fetch('/api/streak', { headers: { Accept: 'application/json' }, signal: ctrl.signal })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        // On n'affiche que des jours VALIDÉS d'affilée, série en cours.
        if (!d || !d.configured || d.state === 'failed') return;
        const jours = Number(d.validatedDay);
        if (!Number.isFinite(jours) || jours <= 0 || !n) return;
        n.textContent = jours.toLocaleString('en-GB');
        if (live && d.updatedAt) {
          const date = new Date(d.updatedAt).toLocaleDateString('en-GB', {
            day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris',
          });
          live.textContent = `${live.dataset.libelle} · ${live.dataset.maj} ${date}`;
          live.hidden = false;
        }
      })
      .catch(() => { /* secours conservé */ })
      .finally(() => clearTimeout(minuteur));
  }
</script>

<style>
  .runner__grid { display: grid; gap: 1.5rem; align-items: start; }
  .runner__texte { display: grid; gap: 1rem; font-size: 1.05rem; color: var(--ad-text); max-width: 40rem; }
  .streak { background: var(--ad-blue); color: var(--ad-white); padding: 1.25rem 1.25rem 1.4rem; }
  .streak__n {
    font-family: var(--ad-display);
    font-weight: 900;
    font-size: clamp(4rem, 20vw, 6rem);
    line-height: 0.85;
  }
  .streak__l { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.45; color: #e9ecff; }
  .streak__live {
    margin-top: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ad-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .streak__live[hidden] { display: none; }
  .streak__live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ad-white);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25);
  }
  .runner__chiffres { margin-top: 2rem; }
  @media (min-width: 860px) {
    .runner__grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 3rem; }
  }
</style>
