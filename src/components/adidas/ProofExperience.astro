---
/* Preuve « EXPERIENCE » : frise courte et sobre + langues. */
import { commun } from '../../data/adidas.js';
import EnTete from './EnTete.astro';

const s = commun.sections.experience;
---

<section class="ad-section xp" id={s.id} aria-labelledby={`${s.id}-titre`}>
  <div class="ad-wrap">
    <EnTete surTitre={s.surTitre} titre={s.titre} id={`${s.id}-titre`} />
    <ol class="xp__liste">
      {s.postes.map((p) => (
        <li>
          <p class="xp__quand">{p.quand}</p>
          <div>
            <p class="xp__ou">{p.ou}</p>
            <p class="xp__role">{p.role}</p>
            {p.detail && <p class="xp__detail">{p.detail}</p>}
          </div>
        </li>
      ))}
    </ol>
    {s.langues && (
      <div class="xp__langues">
        <p class="ad-lab">{s.langues.titre}</p>
        <ul>{s.langues.liste.map((l) => <li>{l}</li>)}</ul>
      </div>
    )}
  </div>
</section>

<style>
  .xp__liste { list-style: none; padding: 0; margin: 0; border-top: 3px solid var(--ad-ink); }
  .xp__liste li { display: grid; gap: 0.35rem; padding: 1.1rem 0; border-bottom: 1px solid var(--ad-line); }
  .xp__quand {
    font-family: var(--ad-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-mute-light);
  }
  .xp__ou { font-family: var(--ad-display); font-weight: 900; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .xp__role { margin-top: 0.25rem; font-weight: 600; color: var(--ad-ink); }
  .xp__detail { margin-top: 0.25rem; font-size: 0.95rem; color: var(--ad-text); max-width: 44rem; }
  .xp__langues { margin-top: 1.75rem; }
  .xp__langues ul { list-style: none; padding: 0; margin: 0.6rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .xp__langues li { border: 2px solid var(--ad-ink); padding: 0.35rem 0.75rem; font-size: 0.95rem; font-weight: 500; }
  @media (min-width: 860px) {
    .xp__liste li { grid-template-columns: 180px minmax(0, 1fr); gap: 2rem; padding: 1.4rem 0; }
    .xp__quand { padding-top: 0.35rem; }
  }
</style>
