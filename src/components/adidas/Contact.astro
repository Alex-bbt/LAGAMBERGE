---
/* PIED DE PAGE / CONTACT (fond noir) : « Let's talk. », e-mail, boutons,
   réseaux (repris de src/data/mediakit.js → `comptes`), mention du stage. */
import { commun } from '../../data/adidas.js';
import { comptes } from '../../data/mediakit.js';
import Boutons from './Boutons.astro';

const { equipe } = Astro.props;
const { contact, email } = commun;
const reseaux = comptes.filter((c) => c && c.url);
---

<footer class="contact" id="contact">
  <div class="ad-wrap">
    <p class="ad-lab"><i>{contact.repere}</i>{contact.surTitre}</p>
    <h2 class="contact__titre">{contact.titre}<em>.</em></h2>
    <a class="contact__mail" href={`mailto:${email}`}>{email}</a>
    <div class="contact__btns"><Boutons pdf={equipe.pdf} fond="noir" /></div>
    {reseaux.length > 0 && (
      <ul class="contact__reseaux">
        {reseaux.map((r) => (
          <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.nom}<span class="sr-only"> (opens in a new tab)</span></a></li>
        ))}
      </ul>
    )}
    <p class="contact__mention">{contact.mention}</p>
  </div>
</footer>

<style>
  .contact { background: var(--ad-ink); color: var(--ad-white); padding-block: clamp(3.5rem, 9vw, 5.5rem) 2.5rem; }
  .contact .ad-lab { color: var(--ad-mute); }
  .contact__titre {
    font-family: var(--ad-display);
    font-weight: 900;
    font-size: clamp(3.75rem, 17vw, 7rem);
    line-height: 0.88;
    text-transform: uppercase;
    margin-top: 0.6rem;
  }
  .contact__titre em { font-style: normal; color: var(--ad-blue); }
  .contact__mail {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--ad-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 5.4vw, 2.25rem);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-bottom: 3px solid var(--ad-blue);
    overflow-wrap: anywhere;
  }
  .contact__mail:hover { color: #c9d0ff; }
  .contact__btns { margin-top: 1.75rem; }
  .contact__reseaux { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .contact__reseaux a {
    display: inline-block;
    padding-block: 0.6rem;
    font-family: var(--ad-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d4d5d9;
    text-decoration: none;
  }
  .contact__reseaux a:hover { color: var(--ad-white); }
  .contact__mention { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #2a2b2f; font-size: 0.875rem; color: var(--ad-mute); }
</style>
