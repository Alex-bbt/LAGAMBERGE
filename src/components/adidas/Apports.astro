---
/* « WHAT I'D BRING TO {TEAM} » : les 3 apports numérotés 01–03. */
import { commun } from '../../data/adidas.js';

const { equipe } = Astro.props;
const { apports } = commun;
---

<section class="ad-section apports" aria-labelledby="apports-titre">
  <div class="ad-wrap">
    <p class="ad-lab"><i>{apports.repere}</i>{equipe.equipe}</p>
    <h2 class="ad-h2" id="apports-titre">{apports.titre} <em>{equipe.equipe}</em></h2>
    <ol class="apports__liste">
      {equipe.apports.map((a, i) => (
        <li>
          <span class="apports__d">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{a.titre}</h3>
            <p>{a.texte}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .apports .ad-h2 { font-size: clamp(2.3rem, 8vw, 3.75rem); }
  .apports__liste { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; }
  .apports__liste li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0.75rem; padding: 1.25rem 0; border-top: 1px solid var(--ad-line); }
  .apports__liste li:first-child { border-top: 3px solid var(--ad-ink); }
  .apports__d { font-family: var(--ad-display); font-weight: 900; font-size: 2rem; line-height: 1; color: var(--ad-blue); }
  .apports__liste h3 { font-family: var(--ad-display); font-weight: 800; font-size: 1.5rem; line-height: 1.05; text-transform: uppercase; letter-spacing: 0.02em; }
  .apports__liste p { margin-top: 0.4rem; color: var(--ad-text); font-size: 1rem; }
  @media (min-width: 860px) {
    .apports__liste { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    .apports__liste li, .apports__liste li:first-child { grid-template-columns: 1fr; border-top: 3px solid var(--ad-ink); padding-top: 1.25rem; }
    .apports__d { font-size: 2.75rem; }
  }
</style>
