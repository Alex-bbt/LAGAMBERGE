---
/* ==========================================================================
   Photo — cadre lg-photo du design system.
   - Si `fichier` est rempli (nom d'un fichier de src/assets/photos/), la photo
     est affichée, redimensionnée et compressée automatiquement par Astro.
   - Sinon : emplacement [PHOTO : description] bien visible.
   ========================================================================== */
import { Image } from 'astro:assets';
import ARemplir from './ARemplir.astro';

const { photo, format = 'paysage', class: classe = '' } = Astro.props;

// Toutes les photos déposées dans src/assets/photos/, indexées par nom.
const fichiers = import.meta.glob('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const image = photo?.fichier
  ? fichiers[`../assets/photos/${photo.fichier}`]?.default
  : null;
---

{image ? (
  <div class={`lg-photo photo photo--${format} ${classe}`}>
    <Image
      src={image}
      alt={photo.alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 720px) 100vw, 50vw"
      loading="lazy"
    />
  </div>
) : (
  <div class={`lg-photo photo photo--${format} photo--vide ${classe}`}>
    <ARemplir texte={`PHOTO : ${photo?.description ?? 'à fournir'}`} />
  </div>
)}
