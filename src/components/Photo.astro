---
/* ==========================================================================
   Photo — cadre lg-photo du design system.
   Affiche la photo si `photo.fichier` correspond à un fichier de
   src/assets/photos/ (Astro la redimensionne et la compresse).
   Sinon le composant n'affiche RIEN : pas d'emplacement vide sur le site.
   ========================================================================== */
import { Image } from 'astro:assets';

const { photo, format = 'paysage', class: classe = '', prioritaire = false } = Astro.props;

const fichiers = import.meta.glob('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const image = photo?.fichier ? fichiers[`../assets/photos/${photo.fichier}`]?.default : null;
---

{image && (
  <div class={`lg-photo photo photo--${format} ${classe}`}>
    <Image
      src={image}
      alt={photo.alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 720px) 100vw, 50vw"
      loading={prioritaire ? 'eager' : 'lazy'}
    />
  </div>
)}
