---
/* ==========================================================================
   Contact — le bloc prioritaire de la page (carte bleu roi).
   - Email renseigné : adresse visible et cliquable, bouton principal
     « Discutons de votre projet » (objet prérempli), copie discrète.
   - Email absent : AUCUN bouton email ; Instagram devient le contact.
   - Réseaux en liens secondaires, plus discrets que le bouton.
   ========================================================================== */
import { contact, comptes } from '../data/mediakit.js';

const insta = comptes.find((c) => c.id === 'instagram');
const autres = comptes.filter((c) => c.id !== 'instagram');
const mailto = contact.email
  ? `mailto:${contact.email}${contact.objetEmail ? `?subject=${encodeURIComponent(contact.objetEmail)}` : ''}`
  : null;
---

<div class="lg-glass lg-glass--royal contact" id="contact">
  <h3 class="label">Contact</h3>
  {contact.email ? (
    <>
      <a class="contact__email lead" href={mailto} data-email>{contact.email}</a>
      <div class="actions">
        <a class="lg-btn lg-btn--glass contact__cta" href={mailto}>Discutons de votre projet</a>
        <button class="contact__copier caption" type="button" data-copier={contact.email}>Copier l’adresse</button>
        <span class="caption contact__retour" role="status" data-retour></span>
      </div>
      <p class="caption">Ou par message privé sur Instagram : <a href={insta.url} target="_blank" rel="noopener noreferrer">{insta.pseudo}</a></p>
    </>
  ) : (
    <>
      <p class="body">Le plus simple aujourd’hui : un message privé sur Instagram.</p>
      <div class="actions">
        <a class="lg-btn lg-btn--glass contact__cta" href={insta.url} target="_blank" rel="noopener noreferrer">
          Écrire sur Instagram {insta.pseudo}<span class="sr-only"> (nouvel onglet)</span>
        </a>
      </div>
    </>
  )}
  <ul class="contact__reseaux caption" role="list">
    {autres.map((c) => (
      <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.nom}<span class="sr-only"> {c.pseudo} (nouvel onglet)</span></a></li>
    ))}
  </ul>
</div>

{contact.email && (
  <script>
    // Copie de l'adresse ; en cas de refus du navigateur, on sélectionne le texte.
    const bouton = document.querySelector('[data-copier]');
    const retour = document.querySelector('[data-retour]');
    bouton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bouton.dataset.copier);
        retour.textContent = 'Adresse copiée.';
      } catch {
        const zone = document.querySelector('[data-email]');
        const r = document.createRange();
        r.selectNodeContents(zone);
        getSelection().removeAllRanges();
        getSelection().addRange(r);
        retour.textContent = 'Adresse sélectionnée.';
      }
    });
  </script>
)}
