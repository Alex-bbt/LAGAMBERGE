---
/* ==========================================================================
   Contact — posé directement sur le fond bleu roi de la section Collaborer.
   - Email renseigné : adresse très visible et cliquable, bouton principal
     « Discutons de votre projet » (couleur d'accent, objet prérempli), copie.
   - Email absent : AUCUN bouton email ; Instagram devient le contact.
   - Bloc final : email dominant, bouton principal, copie, puis les réseaux
     en icônes (composant Reseaux, mêmes URL que partout).
   ========================================================================== */
import Reseaux from './Reseaux.astro';
import { contact, comptes } from '../data/mediakit.js';

const insta = comptes.find((c) => c.id === 'instagram');
const mailto = contact.email
  ? `mailto:${contact.email}${contact.objetEmail ? `?subject=${encodeURIComponent(contact.objetEmail)}` : ''}`
  : null;
---

<div class="contact" id="contact">
  {contact.email ? (
    <>
      <p class="title contact__invite">Une idée de collaboration&nbsp;? Écrivez-moi.</p>
      <a class="contact__email lead" href={mailto} data-email>{contact.email.split('@')[0]}@<wbr />{contact.email.split('@')[1]}</a>
      <div class="actions">
        <a class="lg-btn btn-accent" href={mailto}>Discutons de votre projet</a>
        <button class="lg-btn contact__copier" type="button" data-copier={contact.email}>Copier l’adresse</button>
        <span class="caption contact__retour" role="status" data-retour></span>
      </div>
      <Reseaux classe="reseaux-icones--contact" />
    </>
  ) : (
    <div class="actions">
      <a class="lg-btn btn-accent" href={insta.url} target="_blank" rel="noopener noreferrer">
        Écrire sur Instagram {insta.pseudo}<span class="sr-only"> (nouvel onglet)</span>
      </a>
    </div>
  )}
</div>

{contact.email && (
  <script>
    // Copie de l'adresse ; en cas de refus du navigateur, on sélectionne le texte.
    const bouton = document.querySelector('[data-copier]');
    const retour = document.querySelector('[data-retour]');
    bouton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bouton.dataset.copier);
        retour.textContent = 'Adresse copiée.';
      } catch {
        const zone = document.querySelector('[data-email]');
        const r = document.createRange();
        r.selectNodeContents(zone);
        getSelection().removeAllRanges();
        getSelection().addRange(r);
        retour.textContent = 'Adresse sélectionnée.';
      }
    });
  </script>
)}
